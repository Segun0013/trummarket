NODE_ENV=production
PORT=3000

# Required for wallet persistence
DATABASE_URL=mysql://user:password@host:3306/wallet
JWT_SECRET=replace-with-a-long-random-secret

# Telegram integration
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_WEBAPP_URL=https://your-domain.example

# Optional application integrations
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
